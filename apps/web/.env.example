# Server-side configuration for the Next.js app (never NEXT_PUBLIC_: nothing here is sent to
# browsers). The browser only talks to this app's origin.
# Where middleware.ts proxies /api/v1. Leave unset on Vercel, where vercel.json routes /api/v1/* to
# the `api` service of the same project (docs/ADR-006). Required for production builds anywhere
# else (next build refuses to run without it); development defaults to http://localhost:8000.
API_ORIGIN=http://localhost:8000
# Origin of the private storage that receives signed uploads (Content-Security-Policy
# connect-src), e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_ORIGIN=
# Shared with the API (same value). Only when this app runs on Vercel AND proxies to an API
# outside the project (API_ORIGIN set) does it forward the visitor's IP with it.
TRUSTED_PROXY_SECRET=

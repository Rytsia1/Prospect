# Server-side configuration for the Next.js app (never NEXT_PUBLIC_: nothing here is sent to
# browsers). The browser only talks to this app; /api/v1 is proxied to API_ORIGIN.
# Required for production builds (next build refuses to run without it).
API_ORIGIN=http://localhost:8000
# Origin of the private storage that receives signed uploads (Content-Security-Policy
# connect-src), e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_ORIGIN=
# Shared with the API (same value). Only on Vercel does the proxy forward the visitor's IP with it.
TRUSTED_PROXY_SECRET=

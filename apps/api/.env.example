# Copy to .env for local development. Production values live in the hosting platform's
# environment-variable settings, never in git. docs/SECURITY.md explains every value.

# --- Runtime ---------------------------------------------------------------------------
# development (local), test (CI) or production (the default when unset: fails closed).
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospect
# Trusted browser origins (comma-separated, exact scheme://host[:port]): CORS and the CSRF
# Origin check. Production: the deployed web app only, https. (CORS_ORIGINS still works.)
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# MAX_REQUEST_BODY_BYTES=1048576   # JSON bodies only; PDFs go straight to storage
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Storage (private bucket; the API only hands out short-lived signed URLs) -----------
OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=prospect-documents
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
# SIGNED_URL_TTL_SECONDS=900

# --- Auth ------------------------------------------------------------------------------
# Production: at least 32 random bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-me-with-a-long-random-string
# Shared with the web app's /api proxy (apps/web TRUSTED_PROXY_SECRET); required in production.
# The worker needs neither this nor APP_SECRET: do not set them on the worker service.
# TRUSTED_PROXY_SECRET=
# SESSION_TTL_SECONDS=86400
# The session cookie is Secure by default (required in production). Chrome and Firefox accept
# it on http://localhost; set false only for a browser that does not (e.g. Safari over http).
# SESSION_COOKIE_SECURE=true

# --- Rate limits: <requests>/<window seconds>; sessions per client IP, others per user ----
# RATE_LIMIT_SESSIONS=5/60
# RATE_LIMIT_SESSION_REFRESH=10/3600
# RATE_LIMIT_UPLOADS=20/3600
# RATE_LIMIT_COMPLETE=30/3600
# RATE_LIMIT_FINANCIALS=60/60
# RATE_LIMIT_COMPUTE=30/60
# RATE_LIMIT_EXPORT=10/60
# RATE_LIMIT_WRITES=60/60   # creating companies, scenarios, watchlist entries
# Per client IP too, so new anonymous sessions do not reset them:
# RATE_LIMIT_SESSIONS_DAILY=50/86400
# RATE_LIMIT_UPLOADS_IP=60/3600
# RATE_LIMIT_COMPLETE_IP=90/3600
# RATE_LIMIT_EXPORT_IP=30/60

# --- Upload ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800

# --- Processing (worker) ---------------------------------------------------------------
# PROCESSING_MAX_PAGES=2000
# PROCESSING_TIMEOUT_SECONDS=120
# PROCESSING_MAX_MEMORY_BYTES=2147483648
# PROCESSING_MAX_TEXT_BYTES=50000000
# PROCESSING_MAX_TABLE_CELLS=500000
# PROCESSING_MAX_FACTS=5000
# PROCESSING_MAX_EVIDENCE=5000
# PROCESSING_MAX_ROW_CHARS=2000
# PROCESSING_MAX_ATTEMPTS=3
# PROCESSING_RETRY_BASE_SECONDS=30
# PROCESSING_LEASE_SECONDS=900
# PROCESSING_MAX_OBJECTS=500000
# PROCESSING_MAX_RESULT_BYTES=268435456   # parse result; also the parser's file-size limit
# PROCESSING_NETWORK_ISOLATION=best_effort   # required | best_effort | off (not in production)

# --- Quotas (per user) -----------------------------------------------------------------
# QUOTA_MAX_DOCUMENTS=100
# QUOTA_MAX_STORAGE_BYTES=2147483648
# QUOTA_MAX_ACTIVE_JOBS=3
# QUOTA_MAX_DAILY_JOBS=50
# QUOTA_MAX_QUEUED_JOBS=500   # all users together
# QUOTA_MAX_COMPANIES=100
# QUOTA_MAX_SCENARIOS=200

# --- Threat scanning -------------------------------------------------------------------
# clamav: every PDF is scanned by clamd before parsing (fails closed if clamd is down).
# none: documents are recorded as not_scanned. Production must set one of the two explicitly.
# DOCUMENT_SCANNER=none
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=60

# --- Workspace lifecycle and retention (docs/SECURITY.md §2) ------------------------------
# A workspace with no usable session for WORKSPACE_GRACE_HOURS is deleted; every document is
# deleted DOCUMENT_RETENTION_DAYS after upload (must be set in production).
# WORKSPACE_GRACE_HOURS=24
# DOCUMENT_RETENTION_DAYS=30
# FAILED_DOCUMENT_RETENTION_HOURS=24
# RECONCILE_ORPHAN_GRACE_HOURS=48

# --- Financials / export ---------------------------------------------------------------
# PAGE_DEFAULT_LIMIT=100
# PAGE_MAX_LIMIT=500
# FINANCIALS_MAX_DOCUMENTS=20
# FINANCIALS_MAX_FACTS=10000
# EXPORT_MAX_RECORDS=20000
# EXPORT_MAX_BYTES=20971520

# Balance-sheet reconciliation tolerance (optional; these are the defaults)
# RECONCILIATION_ROUNDING_UNITS=3
# RECONCILIATION_RELATIVE_TOLERANCE=0.0001
